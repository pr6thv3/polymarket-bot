# ── Polymarket API Credentials ─────────────────────────────────────────
# Generate these at https://polymarket.com or via the py-clob-client SDK
POLYGON_PRIVATE_KEY=       # Your Polygon wallet private key (for signing orders)
POLY_API_KEY=              # Polymarket CLOB API key
POLY_API_SECRET=           # Polymarket CLOB API secret
POLY_PASSPHRASE=           # Polymarket CLOB API passphrase

# ── Polygon RPC ───────────────────────────────────────────────────────
POLYGON_RPC_URL=           # Optional: custom Polygon RPC endpoint (defaults to public)

# ── Trading Parameters ────────────────────────────────────────────────
STARTING_CAPITAL=1000      # Starting capital in USD (default: 1000)

# ── AI Signal Model (Optional) ────────────────────────────────────────
# Required only if using the ai_signals strategy with LLM-based analysis
OPENAI_API_KEY=            # OpenAI API key for LLM-enhanced signal scoring

# ── Telegram Alerts (Optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # Telegram bot token for alert notifications
TELEGRAM_CHAT_ID=          # Telegram chat ID to receive alerts
